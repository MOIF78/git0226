{% extends 'base.html.twig' %}

{% block h1 %}Gestion des categories({{ categories|length }}){% endblock %}

{% block body %}


    <a class="btn btn-primary" href="{{ path('app_category_new') }}">Ajouter une catégorie</a>

<table class="table table-striped table-bordered  table-hover text-center mt-3">
    <thead class="table-primary">

            <tr>
                <th>Id</th>
                <th>Title</th>
                <th>Quantité</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
        {% for category in categories %}
            <tr>
                <td>{{ category.id }}</td>
                <td>{{ category.title }}</td>
                <td>{{ category.products|length }}</td>
                <td>

                    <a href="{{ path('app_category_show', {'id' : category.id }) }}" class="text-decoration-none" 
                    title "Voir la fiche">
                        {{ ux_icon('lucide:file', {class: 'text-warning icon25'}) }}
                    </a>

                    <a href="{{ path('app_category_edit', {'id' : category.id }) }}" class="text-decoration-none"
                    title "Modifier la catégorie">
                       {{ ux_icon('lucide:edit', {class: 'text-primary icon25'}) }} 
                    </a> 

                    {{ include('category/_delete_form.html.twig') }}
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="3">Aucun résultat</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    
{% endblock %}
