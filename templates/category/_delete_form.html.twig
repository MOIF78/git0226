<form method="post" class="d-inline-block" action="{{ path('app_category_delete', {'id': category.id}) }}" onsubmit="return confirm('Etes-vous sûr de vouloir supprimer cette catégorie ?');">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ category.id) }}">
    <button  class="btnReset">
        {{ ux_icon('lucide:trash-2', {class: 'text-danger icon25'}) }}
    </button>

{# type= "submit" #}

</form>
